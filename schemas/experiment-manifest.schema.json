{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sts2-ai/experiment-manifest.schema.json",
  "title": "sts2-ai experiment manifest",
  "type": "object",
  "required": [
    "experiment_id",
    "created_at_utc",
    "game_build",
    "emulator_schema_version",
    "binding_version",
    "information_policy",
    "config",
    "seeds"
  ],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string"},
    "ai_commit": {"type": ["string", "null"]},
    "ai_dirty": {"type": ["boolean", "null"]},
    "emulator_commit": {"type": ["string", "null"]},
    "emulator_dirty": {"type": ["boolean", "null"]},
    "game_build": {"type": "string"},
    "emulator_schema_version": {"type": "string"},
    "binding_version": {"type": "string"},
    "information_policy": {"type": "string"},
    "config": {"type": "object"},
    "seeds": {"type": "object", "additionalProperties": {"type": "integer"}},
    "model_ids": {"type": "array", "items": {"type": "string"}},
    "dataset_ids": {"type": "array", "items": {"type": "string"}},
    "strategy_db_snapshot": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
