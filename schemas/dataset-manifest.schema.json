{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sts2-ai/dataset-manifest.schema.json",
  "title": "sts2-ai dataset manifest",
  "type": "object",
  "required": [
    "dataset_id",
    "created_at_utc",
    "kind",
    "ai_commit",
    "emulator_commit",
    "game_build",
    "information_policy",
    "record_count",
    "content_digest",
    "storage_uri"
  ],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string"},
    "kind": {"type": "string"},
    "ai_commit": {"type": "string"},
    "emulator_commit": {"type": "string"},
    "game_build": {"type": "string"},
    "information_policy": {"type": "string"},
    "record_count": {"type": "integer", "minimum": 0},
    "content_digest": {"type": "string"},
    "storage_uri": {"type": "string"}
  },
  "additionalProperties": false
}
